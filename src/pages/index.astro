---
const title = "PEAAII AI Summer Camp for High School Students | UMass Boston, Boston MA";

const camp = {
  org: "Paul English Applied Artificial Intelligence Institute (PEAAII)",
  name: "AI Institute Summer Camp",
  year: "2026",
  slogan: "AI Unbounded.",
  tagline:
    "A hands-on, beginner-friendly AI summer program for high school students at UMass Boston.",

  description:
    "The PEAAII AI Summer Camp at the University of Massachusetts Boston is designed for students with no prior research experience. Through story-driven teaching, hands-on labs, guided practice, and team projects, students learn the foundations of artificial intelligence and research methodology while building their own portfolio-ready work.",

  outcomes: [
    "Identify meaningful problems through real-world observation",
    "Formulate strong research questions",
    "Search for and evaluate academic resources",
    "Design experiments and test hypotheses",
    "Analyze data and draw conclusions",
    "Build a structured research mindset",
    "Develop and present a final AI project prototype",
  ],

  weeklyTopics: [
    "Week 1 — Introduction to AI & Machine Learning",
    "Week 2 — From Neural Networks to Intelligent Machines",
    "Week 3 — Speech & Natural Language Processing",
    "Week 4 — Generative AI & Creativity",
    "Week 5 — From Curiosity to Creation: Build Your First AI Project & Research Portfolio",
  ],

  quickFacts: [
    { label: "Dates", value: "July 27 – August 28, 2026" },
    { label: "Time", value: "9:00 AM – 5:00 PM" },
    { label: "Format", value: "Hybrid: Mon & Fri on campus, Tue–Thu remote" },
    { label: "Audience", value: "Grades 8–12" },
    { label: "Location", value: "UMass Boston, Boston, MA" },
  ],

  highlights: [
    "Multi-level mentorship",
    "Beginner to research-ready",
    "Continuous project development",
    "Portfolio of AI projects",
    "Micro-credential certification",
    "Small cohort learning",
  ],

  formatDetails: [
    "Monday & Friday: On-campus at UMass Boston",
    "Tuesday–Thursday: Remote via Zoom",
    "Pizza provided on in-person days",
    "Lectures + Labs + Practice + Discussions + Mentoring",
  ],

  registration: {
    weekly: "$899/week",
    full: "$4,495 full program",
    deadline: "Rolling admission until full",
    formUrl: "https://docs.google.com/forms/d/e/1FAIpQLSf4EdsUeLiuXqlCfz7l4l3WvPgmRiJWRN0bOMn4cI54-2xJJA/viewform?usp=header",
    note: "Apply using our official Google Application Form.",
  },

  syllabi: [
    {
      title: "Week 1 — Introduction to AI & Machine Learning",
      href: "pdfs/Syllabus_Wan.pdf",
    },
    {
      title: "Week 2 — From Neural Networks to Intelligent Machines",
      href: "pdfs/Bo_camp_syllabus.pdf",
    },
    {
      title: "Week 3 — Speech & Natural Language Processing",
      href: "pdfs/Syllabus_Xiaohui.pdf",
    },
    {
      title: "Week 4 — Generative AI & Creativity",
      href: "pdfs/2026_PEAAII_Shichao Pei - V4.pdf",
    },
    {
      title: "Week 5 — From Curiosity to Creation: Build Your First AI Project & Research Portfolio",
      href: "pdfs/Ping_Chen_AI_Summer_Camp_Syllabus.pdf",
    },
  ],

  contactEmail: "ai@umb.edu",
};

const team = [
  {
    name: "Professor Wei Ding",
    role: "Executive Director, PEAAII",
    photoUrl: "images/Wei Ding Big Data 2024.JPG",
    bio: "Dr. Ding combines expertise in AI, data mining, machine learning, and computational semantics with a deep knowledge of UMass Boston and a strong commitment to student-centered innovation and applied AI education.",
  },
  {
    name: "Professor Ping Chen",
    role: "Professor",
    photoUrl: "images/ping-chen-headshot.jpg",
    bio: "Dr. Ping Chen is a Full Professor of Computer Engineering and Director of the Artificial Intelligence Lab at UMass Boston. His work spans artificial intelligence, natural language processing, and machine learning.",
  },
  {
    name: "Professor Xiaohui Liang",
    role: "Associate Professor",
    photoUrl: "images/Liang_Xiaohui.jpg",
    bio: "Dr. Xiaohui Liang is an Associate Professor of Computer Science at UMass Boston and leads the Mobile Computing and Privacy Lab. His research includes mobile systems, speech and language processing, and privacy.",
  },
  {
    name: "Professor Shichao Pei",
    role: "Assistant Professor",
    photoUrl: "images/Shichao.jpeg",
    bio: "Dr. Shichao Pei is an Assistant Professor in Computer Science at UMass Boston whose research interests include machine learning, foundation models, and AI safety.",
  },
  {
    name: "Professor Bo Sheng",
    role: "Professor",
    photoUrl: "images/bo-sheng-headshot.jpg",
    bio: "Dr. Bo Sheng is a professor of computer science at UMass Boston. His research includes edge computing, mobile systems, cloud computing, robotics, and cybersecurity.",
  },
  {
    name: "Professor Yinxin Wan",
    role: "Assistant Professor",
    photoUrl: "images/WAN-Yinxin.jpg",
    bio: "Dr. Yinxin Wan is an Assistant Professor in Computer Science at UMass Boston. His interests include secure and trustworthy AI, IoT, and networked systems.",
  },
  {
    name: "Chengjie Zheng",
    role: "Graduate Student Assistant",
    photoUrl: "images/ChengjieZ_Avatar.png",
    bio: "Chengjie Zheng is a PhD Candidate in Computer Science at UMass Boston whose research focuses on machine learning, AI reliability, hallucination detection in large language models, and trustworthy AI systems.",
  },
  {
    name: "Rami Huu Nguyen",
    role: "Graduate Student Assistant",
    photoUrl: "images/Rami Huu Nguyen.png",
    bio: "Rami Huu Nguyen is a PhD student working on chatbots, multimodal large language models, and creative AI systems. Her work focuses on evaluation frameworks, RAG pipelines, and building scalable, human-centered AI tools.",
  },
  {
    name: "Ajanee Igharo",
    role: "Undergraduate Student Assistant",
    photoUrl: "images/Ajanee_Headshot.png",
    bio: "Ajanee Igharo is an undergraduate Psychology student at UMass Boston and an accelerated MBA candidate focused on business strategy, data analytics, and artificial intelligence. She supports PEAAII programming, student engagement, and AI initiatives.",
  },
  {
    name: "Dora Nguyen",
    role: "Undergraduate Student Assistant",
    photoUrl: "images/Dora.PNG",
    bio: "Dora (Dawn) Nguyen is an undergraduate Accounting student at UMass Boston’s College of Management. She supports the institute through marketing and design and is interested in financial analysis, data analytics, and the role of AI in business.",
  },
  {
    name: "Rebaz Kamal",
    role: "Undergraduate Student Assistant",
    photoUrl: "images/Rebaz.jpg",
    bio: "Rebaz Kamal is an undergraduate student in the Engineering Department at UMass Boston, majoring in Computer Engineering with a minor in Computer Science. His areas of study include artificial intelligence and large language models.",
  },
  {
    name: "Justin Wang",
    role: "High School Student Assistant",
    photoUrl: "images/Justin.jpg",
    bio: "Justin Wang is a returning PEAAII AI Summer Camp TA with experience applying AI to real-world problems, including healthcare data and LLM pipelines. He is interested in responsible AI and developing systems for real-world impact.",
  },
  {
    name: "Jasmine Gu",
    role: "High School Student Assistant",
    photoUrl: "images/Jasmine_Gu_Photo.JPG",
    bio: "Jasmine Gu is a senior at Lexington High School and an incoming Computer Science student at UC Berkeley. She is passionate about AI and supporting students in learning and exploring new technologies.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>

    <meta
      name="description"
      content="Join UMass Boston's PEAAII AI Summer Camp for high school students. A beginner-friendly hybrid AI program with labs, projects, mentorship, and weekly syllabi."
    />

    <link rel="canonical" href="https://umb-ai-institute.github.io/ai-camp-2026/" />

    <meta name="google-site-verification" content="wBOZATGxiDIc0EO9QJCBz4tmnJ9xgXGehqJou_7qoys" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://umb-ai-institute.github.io/ai-camp-2026/" />
    <meta property="og:title" content="PEAAII AI Summer Camp for High School Students | UMass Boston" />
    <meta
      property="og:description"
      content="A hands-on hybrid AI summer camp for high school students with projects, mentorship, and portfolio-building at UMass Boston."
    />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="PEAAII AI Summer Camp for High School Students | UMass Boston" />
    <meta
      name="twitter:description"
      content="A hands-on hybrid AI summer camp for high school students with projects, mentorship, and portfolio-building at UMass Boston."
    />

    <style>
      :root {
        --bg: #f7f8ff;
        --bg-soft: #eef2ff;
        --surface: #ffffff;
        --surface-2: #f5f7ff;

        /* slightly deeper text for contrast */
        --text: #1f2a6d;
        --muted: #5f6fb0;
      
        /* slightly stronger border */
        --border: #cfd6ff;
      
        --shadow: 0 16px 40px rgba(82, 94, 164, 0.12);
      
        --brand-1: #3b82f6;   /* was #6b7cff */
        --brand-2: #7c6cf6;   /* was #8c63ff */
        --brand-3: #a48bff;   /* was #b48cff */
      
        --accent: #4fa3ff;    /* slightly cleaner blue */
        --accent-soft: #e6f0ff;
      
        --gold: #f0c64f;
        --green: #7bd3a5;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        color: var(--text);
        background:
          radial-gradient(circle at top left, rgba(140, 99, 255, 0.18), transparent 34%),
          radial-gradient(circle at top right, rgba(76, 167, 255, 0.16), transparent 30%),
          linear-gradient(180deg, #fbfcff 0%, #f3f5ff 100%);
        min-height: 100vh;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img {
        max-width: 100%;
        display: block;
      }

      .container {
        max-width: 1140px;
        margin: 0 auto;
        padding: 0 1.25rem;
      }

      .topbar {
        padding: 1rem 0 0.75rem;
      }

      .topbar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }

      .brand {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
      }

      .brand strong {
        font-size: 0.95rem;
        letter-spacing: 0.02em;
        color: var(--brand-2);
        text-transform: uppercase;
      }

      .brand span {
        color: var(--muted);
        font-size: 0.88rem;
      }

      .navlinks {
        display: flex;
        gap: 0.65rem;
        flex-wrap: wrap;
      }

      .navlinks a {
        padding: 0.55rem 0.85rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.88);
        border: 1px solid var(--border);
        color: var(--muted);
        font-size: 0.92rem;
        font-weight: 600;
        box-shadow: 0 6px 18px rgba(82, 94, 164, 0.06);
      }

      .navlinks a:hover {
        color: var(--brand-2);
        border-color: rgba(140, 99, 255, 0.38);
      }

      header.hero {
        padding: 1rem 0 1.5rem;
      }

      .hero-card {
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.95), rgba(246, 248, 255, 0.98));
        border: 1px solid var(--border);
        border-radius: 28px;
        box-shadow: var(--shadow);
        overflow: hidden;
        position: relative;
      }

      .hero-card::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(90deg, rgba(107, 124, 255, 0.08), rgba(140, 99, 255, 0.08)),
          radial-gradient(circle at 20% 0%, rgba(107, 124, 255, 0.18), transparent 28%),
          radial-gradient(circle at 85% 10%, rgba(140, 99, 255, 0.16), transparent 26%);
        pointer-events: none;
      }

      .hero-grid {
        position: relative;
        display: grid;
        grid-template-columns: 1.3fr 0.85fr;
        gap: 1.25rem;
        padding: 2rem;
        align-items: stretch;
      }

      @media (max-width: 920px) {
        .hero-grid {
          grid-template-columns: 1fr;
        }
      }

      .eyebrow {
        display: inline-block;
        padding: 0.35rem 0.8rem;
        border-radius: 999px;
        background: linear-gradient(90deg, var(--brand-1), var(--brand-2));
        color: white;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        margin-bottom: 0.75rem;
      }

      h1, h2, h3 {
        margin: 0;
        letter-spacing: -0.02em;
      }

      h1 {
        font-size: clamp(2rem, 4vw, 3rem);
        line-height: 0.98;
        color: var(--brand-2);
      }

      .hero-slogan {
        margin-top: 0.45rem;
        color: var(--brand-1);
        font-size: 1.15rem;
        font-weight: 800;
      }

      .subhead {
        margin: 1rem 0 0;
        max-width: 62ch;
        color: var(--muted);
        font-size: 1.05rem;
        line-height: 1.7;
      }

      .cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.35rem;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0.85rem 1.15rem;
        border-radius: 14px;
        border: 1px solid var(--border);
        background: white;
        font-weight: 700;
        transition: 140ms ease;
        box-shadow: 0 8px 20px rgba(82, 94, 164, 0.08);
      }

      .btn:hover {
        transform: translateY(-1px);
      }

      .btn.primary {
        background: linear-gradient(135deg, var(--brand-1), var(--brand-2));
        color: white;
        border-color: transparent;
      }

      .btn.secondary {
        background: var(--surface);
        color: var(--brand-2);
      }

      .hero-side {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.95rem;
      }

      .price-card,
      .info-box {
        border: 1px solid var(--border);
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.94);
        box-shadow: 0 10px 24px rgba(82, 94, 164, 0.08);
        padding: 1.1rem;
      }

      .price-card {
        background: linear-gradient(180deg, #ffffff, #f4f1ff);
      }

      .card-label {
        display: inline-block;
        padding: 0.35rem 0.75rem;
        background: linear-gradient(90deg, var(--brand-1), var(--brand-2));
        color: white;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 700;
        margin-bottom: 0.75rem;
      }

      .price-big {
        font-size: clamp(2.1rem, 5vw, 3.3rem);
        line-height: 1;
        color: var(--brand-2);
        font-weight: 900;
      }

      .price-small {
        color: var(--muted);
        font-size: 1rem;
        font-weight: 700;
      }

      .price-full {
        margin-top: 0.45rem;
        color: var(--brand-1);
        font-size: 1.05rem;
        font-weight: 800;
      }

      .quick-grid {
        display: grid;
        gap: 0.7rem;
      }

      .quick-item {
        display: grid;
        grid-template-columns: 92px 1fr;
        gap: 0.7rem;
        padding: 0.7rem 0.8rem;
        border-radius: 14px;
        background: var(--surface-2);
        border: 1px solid #e7eafe;
      }

      .quick-item strong {
        color: var(--brand-2);
        font-size: 0.88rem;
      }

      main {
        padding: 0.2rem 0 3rem;
      }

      section {
        margin-top: 1.6rem;
      }

      .section-head {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 0.9rem;
      }

      .section-title {
        font-size: 1.45rem;
        color: var(--brand-2);
      }

      .section-note {
        margin: 0;
        color: var(--muted);
        line-height: 1.65;
        font-size: 0.98rem;
      }

      .card {
        border: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        padding: 1.15rem;
        box-shadow: 0 10px 24px rgba(82, 94, 164, 0.06);
      }

      .stack {
        display: grid;
        gap: 1rem;
      }

      .grid-2 {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
      }

      .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
      }

      @media (max-width: 950px) {
        .grid-2,
        .grid-3 {
          grid-template-columns: 1fr;
        }
      }

      .feature-list,
      .bullets {
        margin: 0.75rem 0 0;
        padding-left: 1.1rem;
        color: var(--muted);
        line-height: 1.7;
      }

      .pill-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
        margin-top: 0.85rem;
      }

      .pill {
        padding: 0.55rem 0.9rem;
        border-radius: 999px;
        background: linear-gradient(90deg, #edf2ff, #f4ecff);
        border: 1px solid #dde2ff;
        color: var(--brand-2);
        font-weight: 700;
        font-size: 0.92rem;
      }

      .syllabus-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
      }

      @media (max-width: 850px) {
        .syllabus-grid {
          grid-template-columns: 1fr;
        }
      }

      .syllabus-card {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        min-height: 100%;
      }

      .syllabus-card h3 {
        font-size: 1.08rem;
        color: var(--brand-2);
      }

      .syllabus-link {
        margin-top: auto;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        width: fit-content;
        padding: 0.7rem 0.95rem;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--accent-soft), #f4ecff);
        color: var(--brand-2);
        border: 1px solid #dce3ff;
        font-weight: 700;
      }

      .program-strip {
        border: 1px solid #d7defc;
        background: linear-gradient(135deg, #eef3ff, #f7efff);
        border-radius: 22px;
        padding: 1.25rem;
      }

      .program-strip h3 {
        color: var(--brand-2);
        margin-bottom: 0.35rem;
      }

      .reg {
        display: grid;
        grid-template-columns: 1.25fr 0.75fr;
        gap: 1rem;
        align-items: center;
        border-radius: 24px;
        border: 1px solid #d7defc;
        background: linear-gradient(135deg, rgba(107, 124, 255, 0.12), rgba(140, 99, 255, 0.12));
        padding: 1.3rem;
        box-shadow: var(--shadow);
      }

      @media (max-width: 850px) {
        .reg {
          grid-template-columns: 1fr;
        }
      }

      .reg h3 {
        color: var(--brand-2);
        margin-bottom: 0.25rem;
        font-size: 1.2rem;
      }

      .reg p {
        margin: 0.25rem 0 0;
        color: var(--muted);
        line-height: 1.7;
      }

      .reg-meta {
        display: grid;
        gap: 0.5rem;
        margin-top: 0.9rem;
      }

      .reg-meta strong {
        color: var(--brand-2);
      }

      .reg-side {
        display: grid;
        gap: 0.8rem;
      }

      .apply-box {
        background: white;
        border: 1px solid #d9def6;
        border-radius: 20px;
        padding: 1rem;
        text-align: center;
      }

      .apply-box .big {
        color: var(--brand-2);
        font-size: 1.55rem;
        font-weight: 900;
        line-height: 1.1;
      }

      .team-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
      }

      @media (max-width: 950px) {
        .team-grid {
          grid-template-columns: 1fr;
        }
      }

      .person {
        display: grid;
        grid-template-columns: 84px 1fr;
        gap: 1rem;
        align-items: start;
      }

      .avatar {
        width: 84px;
        height: 84px;
        border-radius: 50%;
        overflow: hidden;
        border: 3px solid #dfe5ff;
        background: linear-gradient(135deg, #edf2ff, #f4ecff);
        display: grid;
        place-items: center;
        color: var(--brand-2);
        font-size: 1.1rem;
        font-weight: 900;
      }

      .avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .person h3 {
        font-size: 1.06rem;
      }

      .role {
        margin: 0.18rem 0 0.55rem;
        color: var(--brand-1);
        font-weight: 700;
        font-size: 0.93rem;
      }

      .bio {
        margin: 0;
        color: var(--muted);
        line-height: 1.65;
        font-size: 0.96rem;
      }

      .callout {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
      }

      @media (max-width: 900px) {
        .callout {
          grid-template-columns: 1fr;
        }
      }

      .callout .card {
        background: linear-gradient(180deg, #ffffff, #faf8ff);
      }

      footer {
        padding: 2rem 0 2.6rem;
        text-align: center;
        color: var(--muted);
        font-size: 0.92rem;
      }

      .fineprint {
        margin-top: 0.45rem;
        font-size: 0.86rem;
      }
    </style>
  </head>

  <body>
    <div class="container topbar">
      <div class="topbar-inner">
        <div class="brand">
          <strong>{camp.org}</strong>
          <span>{camp.year} {camp.name}</span>
        </div>

        <nav class="navlinks" aria-label="Page sections">
          <a href="#overview">Overview</a>
          <a href="#syllabi">Syllabi</a>
          <a href="#application">Application</a>
          <a href="#webinar-faq">Webinar & FAQ</a>
          <a href="#team">Meet the Team</a>
        </nav>
      </div>
    </div>

    <header class="hero">
      <div class="container">
        <div class="hero-card">
          <div class="hero-grid">
            <div>
              <span class="eyebrow">UMass Boston • Summer 2026</span>
              <h1>{camp.name}</h1>
              <p class="hero-slogan">{camp.slogan}</p>
              <p class="subhead">{camp.tagline}</p>

              <div class="cta-row">
                <a class="btn primary" href="#application">Apply Now</a>
                <a class="btn secondary" href="#syllabi">View Weekly Syllabi</a>
                <a class="btn secondary" href={`mailto:${camp.contactEmail}?subject=PEAAII%20AI%20Summer%20Camp%20Inquiry`}>
                  Contact Us
                </a>
              </div>
            </div>

            <div class="hero-side">
              <div class="price-card">
                <span class="card-label">Tuition</span>
                <div class="price-big">$899<span style="font-size: 1.05rem; font-weight: 700;"> / week</span></div>
                <div class="price-full">{camp.registration.full}</div>
                <p class="section-note" style="margin-top: 0.7rem;">
                  Flexible hybrid format with on-campus learning, remote instruction, mentoring, and portfolio-building.
                </p>
              </div>

              <aside class="info-box" aria-label="Quick facts">
                <span class="card-label">Quick Facts</span>
                <div class="quick-grid">
                  {camp.quickFacts.map((item) => (
                    <div class="quick-item">
                      <strong>{item.label}</strong>
                      <span>{item.value}</span>
                    </div>
                  ))}
                </div>
              </aside>
            </div>
          </div>
        </div>
      </div>
    </header>

    <main>
      <div class="container">
        <section id="overview" aria-label="Camp Overview">
          <div class="section-head">
            <h2 class="section-title">Program Overview</h2>
            <p class="section-note">A beginner-friendly AI summer experience designed to build confidence, skills, and research thinking.</p>
          </div>

          <div class="stack">
            <div class="card">
              <h3>About the Camp</h3>
              <p class="section-note" style="margin-top: 0.6rem;">{camp.description}</p>
            </div>

            <div class="grid-2">
              <div class="card">
                <h3>What Students Will Learn</h3>
                <ul class="feature-list">
                  {camp.outcomes.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>

              <div class="card">
                <h3>Program Format</h3>
                <ul class="feature-list">
                  {camp.formatDetails.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="program-strip">
              <h3>Why Families Choose This Program</h3>
              <p class="section-note">
                Students progress from curiosity to creation through structured lectures, guided labs, hands-on practice, and personalized mentorship. By the end of the program, each student develops and presents a final project that can support future academic opportunities, competitions, and college applications.
              </p>

              <div class="pill-grid">
                {camp.highlights.map((item) => (
                  <span class="pill">{item}</span>
                ))}
              </div>
            </div>
          </div>
        </section>

        <section aria-label="Weekly Topics">
          <div class="section-head">
            <h2 class="section-title">Weekly Topics</h2>
            <p class="section-note">Students may enroll in individual weeks or complete the full multi-week experience.</p>
          </div>

          <div class="grid-2">
            <div class="card">
              <h3>Summer Schedule</h3>
              <ul class="feature-list">
                {camp.weeklyTopics.map((topic) => (
                  <li>{topic}</li>
                ))}
              </ul>
            </div>

            <div class="card">
              <h3>What Makes It Special</h3>
              <ul class="feature-list">
                <li>Beginner-friendly design for students with little or no research experience</li>
                <li>Hybrid structure with 2 on-campus days and 3 remote days each week</li>
                <li>Strong emphasis on projects, presentations, and academic growth</li>
                <li>Support from professors, graduate mentors, and assistants</li>
                <li>Food provided on in-person days</li>
              </ul>
            </div>
          </div>
        </section>

        <section id="syllabi" aria-label="Weekly Syllabi">
          <div class="section-head">
            <h2 class="section-title">Weekly Syllabi</h2>
            <p class="section-note">Explore each week’s focus, structure, and sample activities.</p>
          </div>

          <div class="syllabus-grid">
            {camp.syllabi.map((s) => (
              <div class="card syllabus-card">
                <h3>{s.title}</h3>
                <p class="section-note">
                  View the full weekly syllabus, topics, and instructional plan.
                </p>
                <a class="syllabus-link" href={s.href} target="_blank" rel="noopener noreferrer">
                  Open syllabus
                </a>
              </div>
            ))}
          </div>
        </section>

        <section aria-label="Why This Camp Matters">
          <div class="section-head">
            <h2 class="section-title">What Students Gain</h2>
            <p class="section-note">A stronger foundation for future research, summer programs, competitions, and academic storytelling.</p>
          </div>

          <div class="callout">
            <div class="card">
              <h3>Research Readiness</h3>
              <p class="section-note" style="margin-top: 0.55rem;">
                Students learn how to ask meaningful questions, test ideas, interpret results, and think in a structured academic way.
              </p>
            </div>

            <div class="card">
              <h3>Portfolio Development</h3>
              <p class="section-note" style="margin-top: 0.55rem;">
                Each student builds project-based work they can use in future applications, competitions, or academic opportunities.
              </p>
            </div>

            <div class="card">
              <h3>Presentation Experience</h3>
              <p class="section-note" style="margin-top: 0.55rem;">
                Students develop confidence by presenting their ideas, explaining their work, and participating in a final showcase.
              </p>
            </div>
          </div>
        </section>

        <section id="application" aria-label="Application">
          <div class="section-head">
            <h2 class="section-title">Application</h2>
            <p class="section-note">Pricing, application details, and the official form.</p>
          </div>

          <div class="reg">
            <div>
              <h3>Apply to the 2026 PEAAII AI Summer Camp</h3>
              <p>{camp.registration.note}</p>

              <div class="reg-meta">
                <span><strong>Weekly Tuition:</strong> {camp.registration.weekly}</span>
                <span><strong>Full Program:</strong> {camp.registration.full}</span>
                <span><strong>Deadline:</strong> {camp.registration.deadline}</span>
                <span><strong>Format:</strong> Hybrid — Monday & Friday on campus, Tuesday–Thursday remote</span>
                <span><strong>Food:</strong> Pizza provided on in-person days</span>
              </div>
            </div>

            <div class="reg-side">
              <div class="apply-box">
                <div class="big">Apply<br />Today</div>
                <p class="section-note" style="margin-top: 0.55rem;">
                  Spots are limited. Early application is encouraged.
                </p>
                <div class="cta-row" style="justify-content: center; margin-top: 1rem;">
                  <a
                    class="btn primary"
                    href={camp.registration.formUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Open Application Form
                  </a>
                </div>
              </div>
            </div>
          </div>
        </section>
        <section id="webinar-faq" aria-label="Webinar Recording and FAQ">
          <div class="section-head">
            <h2 class="section-title">Webinar Recording & FAQ</h2>
            <p class="section-note">
              Watch the registration webinar and explore common questions from families and students.
            </p>
          </div>
        
          <div class="stack">
            <div class="card">
              <h3>AI Institute Summer Camp Registration Webinar</h3>
        
              <div
                style="
                  position: relative;
                  padding-bottom: 56.25%;
                  height: 0;
                  overflow: hidden;
                  border-radius: 18px;
                  margin-top: 1rem;
                "
              >
                <iframe
                  src="https://www.youtube.com/embed/4qZwIq3RroQ"
                  title="AI Institute Summer Camp Registration Webinar"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                  style="
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    border-radius: 18px;
                  "
                ></iframe>
              </div>
            </div>
        
            <div class="card">
                  <h3>FAQ</h3>
                
                  <div class="stack" style="margin-top: 1rem;">
                
                    <div>
                      <h4>1. What’s the top idea and mindset you like for your children have when the camp done?</h4>
                
                      <p class="section-note">
                        The top mindset we want students to have is curiosity, critical thinking, and the confidence to solve real-world problems.
                      </p>
                      <br />
                      <p class="section-note">
                        AI is not just about programming; it is also about problem-solving. Students will learn how to define a problem, figure out the best way to provide a solution, and identify the best AI tools to address those problems efficiently.
                      </p>
                    </div>
                
                    <div>
                      <h4>2. How will this program prepare students for the future?</h4>
                
                      <p class="section-note">
                        Our summer camp gives students a unique opportunity to cope with the new AI revolution. The world is very different now, and AI is changing very fast. The summer camp trains students not only to use AI tools, but also to think about how to address real-world problems. If students only know how to do coding, that is not enough. The camp provides training on how to solve problems, how to build real-world applications, and how to present their ideas.
                      </p>
                      <br />
                      <p class="section-note">
                        Students can complete portfolio-ready end-to-end projects, and they can use the summer camp outcome for other research competitions, college applications, or future research pathways.
                      </p>
                    </div>
                
                    <div>
                      <h4>3. How do students with no coding experience succeed in the camp?</h4>
                
                      <p class="section-note">
                        We understand that students come with different levels of technical skills. Some students may already know Python, and some may have zero coding background. That is okay.
                      </p>
                      <br />
                      <p class="section-note">
                        Each day, professors provide lectures in the morning, PhD students lead live sessions in the afternoon, and assistants provide guided practice and personal help. We will also share some materials before the summer camp starts, so students can review the basic principles of coding.
                      </p>
                      <br />
                      <p class="section-note">
                        The more important part for our summer camp is whether the student is curious, willing to learn, and willing to solve problems.
                      </p>
                    </div>
                
                    <div>
                      <h4>4. What can a 9th grader learn in one or two weeks? What kind of projects would you offer?</h4>
                
                      <p class="section-note">
                        Each week is independent, so students can join one week or stack any week in any order they like. Even in one or two weeks, students can learn key AI foundations and build hands-on projects.
                      </p>
                      <br />
                      <p class="section-note">
                        For example, students can build their first machine learning model, work on computer vision and object detection, build an AI chatbot, create generative AI projects with text, images, audio, and video, or present a poster or report.
                      </p>
                      <br />
                      <p class="section-note">
                        The goal is that students do not just learn concepts. They work directly with AI tools, design inputs, compare outputs, build projects, and present what they created with their teams.
                      </p>
                    </div>
                
                    <div>
                      <h4>5. Do you have any standout projects or success stories?</h4>
                
                      <p class="section-note">
                        We also want to share one example from last summer. During one lab session, we saw three boys playing games together. At first, we were upset. But our TAs were very patient. They talked with the boys to see what their interests were and encouraged them to focus on expanding them.
                      </p>
                      <br />
                      <p class="section-note">
                        On the last day, those three boys built a computer game to explain why it is important to protect the environment and protect the Earth. They connected their personal interest in games with AI, education, and a real-world problem. This shows why personal guidance and multi-level mentorship are so important.
                      </p>
                    </div>
                
                    <div>
                      <h4>6. Why is this year’s camp stronger?</h4>
                
                      <p class="section-note">
                        We decided to make the summer camp a university-level AI training experience. Every day, the professor will provide a 3-hour lecture on fundamental theories, methods, and real-world cases. The PhD student will lead a 3-hour live session in the afternoon, and the assistants will provide two hours of guided practice at different levels of mentorship.
                      </p>
                      <br />
                      <p class="section-note">
                        We target to help students build real-world applications and complete portfolio-ready end-to-end projects. Students can use the summer camp outcome for research competitions, college applications, academic programs, or publication pathways. For competent students, PhD advisors are eager to help them learn how to do research, how to do critical thinking, and how to pursue future opportunities.
                      </p>
                    </div>
                
                  </div>
                </div>
  
        </section> 
        <section id="team" aria-label="Meet the Team">
          <div class="section-head">
            <h2 class="section-title">Meet the Team</h2>
            <p class="section-note">Faculty and student support staff leading the program.</p>
          </div>

          <div class="team-grid">
            {team.map((p) => (
              <div class="card">
                <div class="person">
                  <div class="avatar" aria-hidden="true">
                    {p.photoUrl ? (
                      <img src={p.photoUrl} alt={`${p.name} headshot`} />
                    ) : (
                      <span>{p.name.split(" ").map((x) => x[0]).join("").slice(0, 2).toUpperCase()}</span>
                    )}
                  </div>

                  <div>
                    <h3>{p.name}</h3>
                    <p class="role">{p.role}</p>
                    <p class="bio">{p.bio}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      </div>
    </main>

    <footer>
      <div class="container">
        © {camp.year} {camp.org}
        <div class="fineprint">
          Questions? Email <a href={`mailto:${camp.contactEmail}`}>{camp.contactEmail}</a>
        </div>
      </div>
    </footer>
  </body>
</html>
